# ---------------------------------------------------------------
# Configuration de l'environnement Symfony
# ---------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=9f2b1c4d5e6a7b8c9d0e1f2a3b4c5d6e

# ---------------------------------------------------------------
# Base de données PostgreSQL
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE?serverVersion=..&charset=utf8
# >>> Adaptez l'utilisateur, le mot de passe et le nom de la base <<<
# ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:1234@127.0.0.1:5432/ticket_track?serverVersion=18&charset=utf8"

# ---------------------------------------------------------------
# Authentification JWT (implémentation HMAC-SHA256 maison)
# ---------------------------------------------------------------
JWT_SECRET=change_this_super_secret_key_in_production
JWT_TTL=86400

# Origines autorisées pour le CORS (frontend React)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
